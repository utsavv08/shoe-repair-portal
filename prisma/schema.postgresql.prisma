// Production PostgreSQL Schema (Supabase, Neon, AWS RDS, Railway, Render)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             String          @id @default(uuid())
  mobile         String          @unique
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  repairRequests RepairRequest[]

  @@index([mobile])
}

model RepairRequest {
  id             String      @id @default(uuid())
  trackingId     String      @unique
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  repairType     String
  shoeBrand      String?
  shoeModel      String?
  shoeSize       String?
  
  // Step 2: Google Cloud Vision OCR Extraction Fields (Asynchronous)
  ocrStatus       String?     // PENDING | PROCESSING | COMPLETED | PARTIAL | FAILED | SKIPPED
  ocrConfidence   Float?      // 0.0 to 1.0 confidence score
  ocrRawText      String?     // Full raw OCR output from Google Cloud Vision
  extractedBrand  String?     // Cleaned Brand isolated via Regex/Heuristics
  extractedModel  String?     // Cleaned Style / SKU / Model code
  extractedSize   String?     // Cleaned Size (e.g. US 9.5 / UK 8.5 / EUR 43 / CM 27.5)
  ocrProcessedAt  DateTime?   // Timestamp when async OCR finished
  
  pickupLocation String
  pickupDate     String
  pickupTimeSlot String
  
  status         String      @default("PENDING_PICKUP")
  notes          String?
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  photos         ShoePhoto[]

  @@index([customerId])
  @@index([trackingId])
  @@index([status])
  @@index([ocrStatus])
}

model ShoePhoto {
  id              String        @id @default(uuid())
  repairRequestId String
  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  
  angle           String
  s3Url           String
  s3Key           String?
  originalSize    Int?
  compressedSize  Int?
  createdAt       DateTime      @default(now())

  @@index([repairRequestId])
  @@index([angle])
}
