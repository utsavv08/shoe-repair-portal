# ==========================================
# SoleCraft Studio - Environment Configuration
# ==========================================

# 1. PostgreSQL Database URL (Supabase, Neon, AWS RDS, Render, Railway, or Local Postgres)
# Example for Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Example for Neon: postgresql://user:password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/solecraft_db?schema=public"

# 2. AWS S3 Storage Credentials (Optional)
# If omitted, uploads run in local mock preview mode
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=solecraft-repair-uploads

# 3. Application Port & Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
